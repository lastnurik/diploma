%% Proposed components and main outcome paths, not an implemented deployment.
%% The platform mediates approved artifact delivery; detailed broker and storage contracts are in docs/architecture.md.
flowchart LR
  accTitle: Proposed component architecture
  accDescr: The authoring interface sends a story to the platform, which starts an AI generation job and returns status or failure. The worker produces an untrusted candidate. An independent gate approves game data before storage. The platform serves only an authorized ready version to the maintained browser runtime.

  UI["Author UI<br/>Story + versions"]
  PLATFORM["Platform service<br/>Jobs + status"]
  AI["AI worker<br/>Candidate data"]
  GATE["Validation gate<br/>Rules + ending"]
  STORE[("Game storage<br/>Approved version")]
  RUNTIME["Browser runtime<br/>Actions + ending"]

  UI -->|"Story"| PLATFORM
  PLATFORM -->|"Status / failure"| UI
  PLATFORM -->|"Job"| AI
  AI -->|"Candidate"| GATE
  GATE -->|"Outcome"| PLATFORM
  GATE -->|"Approved"| STORE
  STORE -->|"Artifact read"| PLATFORM
  UI -->|"Play ready"| RUNTIME
  PLATFORM -->|"Authorized ready data"| RUNTIME

  classDef untrusted fill:#fff1eb,stroke:#9a492d,color:#3f261e;
  classDef gate fill:#e6f2ed,stroke:#33745b,color:#17382b;
  class AI untrusted;
  class GATE gate;
